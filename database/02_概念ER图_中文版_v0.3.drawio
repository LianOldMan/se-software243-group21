<diagram id="lab2concept" name="实验二中文版概念ER图_v0.3">
<mxGraphModel dx="1540" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="实验二 · 中文版概念 ER 图 v0.3（第1步定稿）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=27;fontStyle=1;fontColor=#233449;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1400" height="75" as="geometry"/></mxCell><mxCell id="subtitle" value="需求基线：v0.5.6 ｜ 中文标注 ｜ 数量关系包含历史订单" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#506071;" vertex="1" parent="1"><mxGeometry x="175" y="95" width="1140" height="33" as="geometry"/></mxCell><mxCell id="u" value="&lt;div style='line-height:1.52;font-family:Arial,sans-serif'&gt;&lt;b&gt;用户（预置账号）&lt;/b&gt;&lt;br/&gt;&lt;span&gt;────────────────────────&lt;/span&gt;&lt;br/&gt;用户编号　唯一标识&lt;br/&gt;预置账号　必填且唯一&lt;br/&gt;&lt;br/&gt;&lt;i&gt;同一用户可同时作为买家和卖家&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#4F76A2;strokeWidth=2;align=left;verticalAlign=middle;fontSize=17;fontFamily=Noto Sans CJK SC;fontColor=#1E3551;spacing=18;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="550" y="135" width="345" height="225" as="geometry"/></mxCell><mxCell id="b" value="&lt;div style='line-height:1.52;font-family:Arial,sans-serif'&gt;&lt;b&gt;书籍发布记录&lt;/b&gt;&lt;br/&gt;&lt;span&gt;────────────────────────&lt;/span&gt;&lt;br/&gt;发布记录编号　唯一标识&lt;br/&gt;书名（必填）&lt;br/&gt;作者（必填）&lt;br/&gt;价格（大于零、最多两位小数）&lt;br/&gt;成色（三档）&lt;br/&gt;说明（选填）&lt;br/&gt;书籍状态：可售／已预留&lt;br/&gt;发布时间（系统生成）&lt;br/&gt;&lt;br/&gt;&lt;i&gt;一条记录代表一本实物书&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F6EF;strokeColor=#448A69;strokeWidth=2;align=left;verticalAlign=middle;fontSize=17;fontFamily=Noto Sans CJK SC;fontColor=#1E3551;spacing=18;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="445" height="300" as="geometry"/></mxCell><mxCell id="o" value="&lt;div style='line-height:1.52;font-family:Arial,sans-serif'&gt;&lt;b&gt;预留订单&lt;/b&gt;&lt;br/&gt;&lt;span&gt;────────────────────────&lt;/span&gt;&lt;br/&gt;订单编号　唯一标识&lt;br/&gt;订单状态：有效／已取消&lt;br/&gt;下单时间（必填／系统生成）&lt;br/&gt;取消时间（取消后须记录）&lt;br/&gt;&lt;br/&gt;&lt;i&gt;历史订单不删除；当前有效最多一个&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#B98040;strokeWidth=2;align=left;verticalAlign=middle;fontSize=17;fontFamily=Noto Sans CJK SC;fontColor=#1E3551;spacing=18;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="990" y="515" width="420" height="300" as="geometry"/></mxCell><mxCell id="r1" value="发布" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF4FB;strokeColor=#6F8DB0;strokeWidth=2;align=center;verticalAlign=middle;fontSize=20;fontFamily=Noto Sans CJK SC;fontStyle=1;fontColor=#264364;" vertex="1" parent="1"><mxGeometry x="290" y="390" width="140" height="100" as="geometry"/></mxCell><mxCell id="r2" value="预留" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF4FB;strokeColor=#6F8DB0;strokeWidth=2;align=center;verticalAlign=middle;fontSize=20;fontFamily=Noto Sans CJK SC;fontStyle=1;fontColor=#264364;" vertex="1" parent="1"><mxGeometry x="1050" y="390" width="140" height="100" as="geometry"/></mxCell><mxCell id="r3" value="关联订单" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF4FB;strokeColor=#6F8DB0;strokeWidth=2;align=center;verticalAlign=middle;fontSize=20;fontFamily=Noto Sans CJK SC;fontStyle=1;fontColor=#264364;" vertex="1" parent="1"><mxGeometry x="650" y="625" width="160" height="95" as="geometry"/></mxCell><mxCell id="e1" value="每条发布 1 用户" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="u" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="每人 0..N 发布" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="r1" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="每条订单 1 买家" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="u" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="每人 0..N 订单" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="r2" target="o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="每条订单 1 本书" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="b" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="每书历史 0..N 订单" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="r3" target="o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rule" value="核心约束：每书允许多条取消历史，但同一时刻有效订单 ≤ 1；书籍已预留 ⇔ 存在恰好一条有效订单；旧 O1 不能影响新 O2。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FB;strokeColor=#AAB7C8;dashed=1;strokeWidth=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Noto Sans CJK SC;fontColor=#25374B;" vertex="1" parent="1"><mxGeometry x="110" y="915" width="1280" height="72" as="geometry"/></mxCell><mxCell id="cardinality_legend" value="基数图例：父实体端 1＝每个子记录必须且仅关联一个父记录（不可为空）；子实体端 0..N＝父实体可有零至多条子记录（可选参与）。\n“有效订单 ≤ 1”是条件业务约束，不改变历史联系的 0..N 基数。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#728AA7;strokeWidth=1;align=center;verticalAlign=middle;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#24384E;spacing=8;" vertex="1" parent="1"><mxGeometry x="115" y="832" width="1270" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>