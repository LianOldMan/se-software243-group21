<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="ChatGPT" version="24.7.17">
  <diagram id="lab2-er-concept-v01" name="实验二概念ER图 v0.1">
    <mxGraphModel dx="1152" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="实验二 · 校园二手书交易平台 | 概念 ER 图 v0.1" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1B3656;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1"><mxGeometry x="185" y="10" width="720" height="45" as="geometry"/></mxCell>
        <mxCell id="u" value="&lt;div style=&quot;font-family:Microsoft YaHei,Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#274E70;color:white;text-align:center;padding:10px;font-size:18px;font-weight:bold&quot;&gt;用户 User&lt;/div&gt;&lt;div style=&quot;padding:10px;font-size:13px;line-height:1.7&quot;&gt;&lt;b&gt;user_id&lt;/b&gt; （唯一标识）&lt;br&gt;login_name（预置账号名，设计建议）&lt;br&gt;可同时担任买家与卖家&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FBFE;strokeColor=#7895AE;fontColor=#1E293B;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Noto Sans CJK SC;shadow=0;" vertex="1" parent="1"><mxGeometry x="390" y="95" width="310" height="170" as="geometry"/></mxCell>
        <mxCell id="b" value="&lt;div style=&quot;font-family:Microsoft YaHei,Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#276A77;color:white;text-align:center;padding:10px;font-size:18px;font-weight:bold&quot;&gt;书籍发布记录 BookListing&lt;/div&gt;&lt;div style=&quot;padding:10px;font-size:13px;line-height:1.7&quot;&gt;&lt;b&gt;listing_id&lt;/b&gt;（唯一标识）&lt;br&gt;title、author、price&lt;br&gt;condition、description（可选）&lt;br&gt;listing_status：可售 / 已预留&lt;br&gt;created_at：系统生成发布时间&lt;br&gt;1条发布 = 1本实物书&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FBFE;strokeColor=#7895AE;fontColor=#1E293B;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Noto Sans CJK SC;shadow=0;" vertex="1" parent="1"><mxGeometry x="65" y="415" width="395" height="230" as="geometry"/></mxCell>
        <mxCell id="o" value="&lt;div style=&quot;font-family:Microsoft YaHei,Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#6D4D7C;color:white;text-align:center;padding:10px;font-size:18px;font-weight:bold&quot;&gt;预留订单 ReservationOrder&lt;/div&gt;&lt;div style=&quot;padding:10px;font-size:13px;line-height:1.7&quot;&gt;&lt;b&gt;order_id&lt;/b&gt;（唯一标识）&lt;br&gt;order_status：有效 / 已取消&lt;br&gt;created_at（设计建议）&lt;br&gt;canceled_at（可选设计建议）&lt;br&gt;1笔订单属于1位买家和1本书&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FBFE;strokeColor=#7895AE;fontColor=#1E293B;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Noto Sans CJK SC;shadow=0;" vertex="1" parent="1"><mxGeometry x="620" y="415" width="395" height="230" as="geometry"/></mxCell>
        <mxCell id="e1" value="发布：User 1 ↔ BookListing 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#496C8D;strokeWidth=2;endArrow=none;startArrow=none;fontSize=13;fontFamily=Noto Sans CJK SC;fontColor=#1F3A56;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="u" target="b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="下单：User 1 ↔ ReservationOrder 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#496C8D;strokeWidth=2;endArrow=none;startArrow=none;fontSize=13;fontFamily=Noto Sans CJK SC;fontColor=#1F3A56;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="u" target="o"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="历史关联：BookListing 1 ↔ ReservationOrder 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#496C8D;strokeWidth=2;endArrow=none;startArrow=none;fontSize=13;fontFamily=Noto Sans CJK SC;fontColor=#1F3A56;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b" target="o"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="关键：一本书可关联多条已取消历史订单，但同一时刻最多一个“有效”订单。每笔订单必须恰好关联一名买家和一本书。&lt;br&gt;本图是业务概念 ER，不等于数据库表间关系图；SQL 主外键、数据字典、事务规则在下一步讨论。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF4F9;strokeColor=#CBD5E1;fontColor=#334155;align=center;verticalAlign=middle;fontSize=14;fontFamily=Noto Sans CJK SC;spacing=10;" vertex="1" parent="1"><mxGeometry x="85" y="715" width="920" height="86" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
