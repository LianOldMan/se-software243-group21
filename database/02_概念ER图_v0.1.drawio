<diagram id="lab2concept" name="实验二概念ER图">
<mxGraphModel dx="1540" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="实验二 · 概念 ER 图（不是表间关系图）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=27;fontStyle=1;fontColor=#233449;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1400" height="75" as="geometry"/></mxCell><mxCell id="subtitle" value="基线：需求 v0.5.6 ｜ 三实体 ｜ 关系的基数包含全部历史订单" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#506071;" vertex="1" parent="1"><mxGeometry x="175" y="95" width="1140" height="33" as="geometry"/></mxCell><mxCell id="u" value="&lt;div style='line-height:1.52;font-family:Arial,sans-serif'&gt;&lt;b&gt;USER · 预置用户&lt;/b&gt;&lt;br/&gt;&lt;span&gt;────────────────────────&lt;/span&gt;&lt;br/&gt;user_id　主标识（必选）&lt;br/&gt;account_code　账号标识（建议）&lt;br/&gt;&lt;br/&gt;&lt;i&gt;同一用户可同时作为买家和卖家&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#4F76A2;strokeWidth=2;align=left;verticalAlign=middle;fontSize=17;fontFamily=Noto Sans CJK SC;fontColor=#1E3551;spacing=18;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="550" y="135" width="345" height="225" as="geometry"/></mxCell><mxCell id="b" value="&lt;div style='line-height:1.52;font-family:Arial,sans-serif'&gt;&lt;b&gt;BOOK_LISTING · 书籍发布记录&lt;/b&gt;&lt;br/&gt;&lt;span&gt;────────────────────────&lt;/span&gt;&lt;br/&gt;book_id　主标识&lt;br/&gt;title　书名（必填）&lt;br/&gt;author　作者（必填）&lt;br/&gt;price　价格（&gt; 0，最多两位小数）&lt;br/&gt;condition　成色（三档）&lt;br/&gt;description　选填说明&lt;br/&gt;status　可售／已预留&lt;br/&gt;created_at　系统生成发布时间&lt;br/&gt;&lt;br/&gt;&lt;i&gt;一条记录代表一本实物书&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F6EF;strokeColor=#448A69;strokeWidth=2;align=left;verticalAlign=middle;fontSize=17;fontFamily=Noto Sans CJK SC;fontColor=#1E3551;spacing=18;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="445" height="300" as="geometry"/></mxCell><mxCell id="o" value="&lt;div style='line-height:1.52;font-family:Arial,sans-serif'&gt;&lt;b&gt;RESERVATION_ORDER · 预留订单&lt;/b&gt;&lt;br/&gt;&lt;span&gt;────────────────────────&lt;/span&gt;&lt;br/&gt;order_id　主标识&lt;br/&gt;status　有效／已取消&lt;br/&gt;created_at　下单时间（设计建议）&lt;br/&gt;cancelled_at　取消时间（可选建议）&lt;br/&gt;&lt;br/&gt;&lt;i&gt;历史订单不删除；当前有效最多一个&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#B98040;strokeWidth=2;align=left;verticalAlign=middle;fontSize=17;fontFamily=Noto Sans CJK SC;fontColor=#1E3551;spacing=18;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="990" y="515" width="420" height="300" as="geometry"/></mxCell><mxCell id="r1" value="发布" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF4FB;strokeColor=#6F8DB0;strokeWidth=2;align=center;verticalAlign=middle;fontSize=20;fontFamily=Noto Sans CJK SC;fontStyle=1;fontColor=#264364;" vertex="1" parent="1"><mxGeometry x="290" y="390" width="140" height="100" as="geometry"/></mxCell><mxCell id="r2" value="预留" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF4FB;strokeColor=#6F8DB0;strokeWidth=2;align=center;verticalAlign=middle;fontSize=20;fontFamily=Noto Sans CJK SC;fontStyle=1;fontColor=#264364;" vertex="1" parent="1"><mxGeometry x="1050" y="390" width="140" height="100" as="geometry"/></mxCell><mxCell id="r3" value="关联订单" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF4FB;strokeColor=#6F8DB0;strokeWidth=2;align=center;verticalAlign=middle;fontSize=20;fontFamily=Noto Sans CJK SC;fontStyle=1;fontColor=#264364;" vertex="1" parent="1"><mxGeometry x="650" y="625" width="160" height="95" as="geometry"/></mxCell><mxCell id="e1" value="每条发布 1 用户" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="u" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="每人 0..N 发布" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="r1" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="每条订单 1 买家" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="u" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="每人 0..N 订单" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="r2" target="o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="每条订单 1 本书" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="b" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="每书历史 0..N 订单" style="endArrow=none;startArrow=none;strokeColor=#6A7B92;strokeWidth=2;rounded=1;html=1;labelBackgroundColor=#FFFFFF;fontSize=15;fontFamily=Noto Sans CJK SC;fontColor=#34465C;" edge="1" parent="1" source="r3" target="o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rule" value="核心约束：同一本书可有多条历史订单，但同时最多一条有效订单；不允许自购；旧 O1 不得影响新 O2。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FB;strokeColor=#AAB7C8;dashed=1;strokeWidth=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Noto Sans CJK SC;fontColor=#25374B;" vertex="1" parent="1"><mxGeometry x="210" y="850" width="1090" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>