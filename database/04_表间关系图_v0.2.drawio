        <mxCell id="o7" value="request_token&nbsp;&nbsp;CHAR(36)&nbsp;&nbsp;NOT NULL&nbsp;&nbsp;UNIQUE(buyer_id,request_token)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="880" y="904" width="760" height="24" as="geometry"/></mxCell>
        <mxCell id="o8" value="active_listing_id&nbsp;&nbsp;生成列（非 FK）&nbsp;&nbsp;UNIQUE（有效≤1）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="880" y="932" width="760" height="24" as="geometry"/></mxCell>
        <mxCell id="e1" value="seller_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;strokeWidth=2;endFill=1;" edge="1" parent="1" source="u" target="b"><mxGeometry relative="1" as="geometry"/><mxCell id="e1s" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1E693C;fontSize=11;" vertex="1" connectable="0" parent="e1"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e1t" value="0..N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1E693C;fontSize=11;" vertex="1" connectable="0" parent="e1"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell>
        <mxCell id="e2" value="buyer_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;strokeWidth=2;endFill=1;" edge="1" parent="1" source="u" target="o"><mxGeometry relative="1" as="geometry"/><mxCell id="e2s" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1E693C;fontSize=11;" vertex="1" connectable="0" parent="e2"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e2t" value="0..N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1E693C;fontSize=11;" vertex="1" connectable="0" parent="e2"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell>
        <mxCell id="e3" value="listing_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;strokeWidth=2;endFill=1;" edge="1" parent="1" source="b" target="o"><mxGeometry relative="1" as="geometry"/><mxCell id="e3s" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1E693C;fontSize=11;" vertex="1" connectable="0" parent="e3"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e3t" value="0..N（历史）" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1E693C;fontSize=11;" vertex="1" connectable="0" parent="e3"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></mxCell>
        <mxCell id="n1" value="<b>基数读法</b>：连线父端 1，子端 0..N —— 一个发布者可有 0..N 条书籍发布记录；一个预置账号可有 0..N 张订单；一本书可有 0..N 条历史订单。<br><b>三个外键均 NOT NULL</b>、建议 ON DELETE RESTRICT：book_listing.seller_id、reservation_order.buyer_id、reservation_order.listing_id。<br><b>条件性技术约束 ①</b>：UNIQUE(buyer_id, request_token) —— 同一买家的同一逻辑下单请求不重复建单；幂等手段，不是业务字段要求。<br><b>条件性技术约束 ②</b>：生成列 active_listing_id = CASE WHEN order_status='有效' THEN listing_id ELSE NULL END，加 UNIQUE 保证同书有效订单至多 1 条；它是本行派生列，不是实体、不是外键。<br><b>MySQL 前提</b>：CHECK 约束与生成列按 MySQL 8.0.16+ 语法；DECIMAL(10,2) 仍需应用层按输入字符串拒绝超过两位小数（受 sql_mode 影响）。<br>本图为逻辑设计推演，未执行建表 SQL；字段与约束以 database/03_逻辑表设计与数据字典_v0.2.md 为准。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="1040" width="1640" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
