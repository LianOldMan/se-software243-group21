<mxCell id="title" value="UC-04 下单预留活动图 v0.2" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="800" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="对象：ReservationController / ReservationService / Repository ｜ 按统一类与操作约定 v0.3 ｜ 设计推演，未实现、未实测" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4b5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="68" width="1360" height="24" as="geometry"/></mxCell><mxCell id="line" value="" style="line;strokeWidth=1;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="96" width="1400" height="1" as="geometry"/></mxCell><mxCell id="tx" value="«transaction» 服务事务：锁定书籍后校验，任一异常回滚" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#6b7280;fillColor=none;align=left;verticalAlign=top;spacing=10;fontSize=9;" vertex="1" parent="1"><mxGeometry x="390" y="570" width="620" height="700" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="688" y="106" width="24" height="24" as="geometry"/></mxCell><mxCell id="a1" value="买家提交 reserveBook(buyerId, listingId, requestToken)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="540" height="54" as="geometry"/></mxCell><mxCell id="d1" value="users.findById(buyerId) ≠ null ∧ token 格式合法？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="565.0" y="227.0" width="270" height="96" as="geometry"/></mxCell><mxCell id="e1" value="异常结束：INVALID_USER / INVALID_TOKEN&lt;br&gt;不写库，返回错误" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1080" y="240" width="340" height="62" as="geometry"/></mxCell><mxCell id="end-e1-outer" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#111827;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1434" y="259" width="24" height="24" as="geometry"/></mxCell><mxCell id="end-e1-inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="1440" y="265" width="12" height="12" as="geometry"/></mxCell><mxCell id="e1-end1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#dc2626;" edge="1" parent="1" source="e1" target="end-e1-outer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="查询同买家 + token：findByBuyerAndToken" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="430" y="370" width="540" height="54" as="geometry"/></mxCell><mxCell id="d2" value="token 已存在？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575.0" y="447.0" width="250" height="96" as="geometry"/></mxCell><mxCell id="replay" value="返回原订单当前状态&lt;br&gt;replayed=true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1040" y="380" width="330" height="58" as="geometry"/></mxCell><mxCell id="e2" value="拒绝 TOKEN_TARGET_MISMATCH&lt;br&gt;回滚，不能把 A 书订单当 B 书成功" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1040" y="500" width="330" height="62" as="geometry"/></mxCell><mxCell id="end-e2-outer" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#111827;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1434" y="519" width="24" height="24" as="geometry"/></mxCell><mxCell id="end-e2-inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="1440" y="525" width="12" height="12" as="geometry"/></mxCell><mxCell id="e2-end2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#dc2626;" edge="1" parent="1" source="e2" target="end-e2-outer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="开启事务；lockById(listingId) 锁定书籍" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="430" y="600" width="540" height="58" as="geometry"/></mxCell><mxCell id="d3" value="书存在且可售？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575.0" y="677.0" width="250" height="96" as="geometry"/></mxCell><mxCell id="e3" value="LISTING_NOT_FOUND / ALREADY_RESERVED&lt;br&gt;回滚，不产生新订单" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1080" y="690" width="340" height="62" as="geometry"/></mxCell><mxCell id="end-e3-outer" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#111827;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1434" y="709" width="24" height="24" as="geometry"/></mxCell><mxCell id="end-e3-inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="1440" y="715" width="12" height="12" as="geometry"/></mxCell><mxCell id="e3-end3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#dc2626;" edge="1" parent="1" source="e3" target="end-e3-outer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d4" value="买家 ≠ 卖家？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="585.0" y="804.0" width="230" height="92" as="geometry"/></mxCell><mxCell id="e4" value="SELF_RESERVATION&lt;br&gt;回滚，禁止预留自己发布的书" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1080" y="820" width="340" height="62" as="geometry"/></mxCell><mxCell id="end-e4-outer" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#111827;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1434" y="839" width="24" height="24" as="geometry"/></mxCell><mxCell id="end-e4-inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="1440" y="845" width="12" height="12" as="geometry"/></mxCell><mxCell id="e4-end4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#dc2626;" edge="1" parent="1" source="e4" target="end-e4-outer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="锁后复查 token（命中返回原单）&lt;br&gt;未命中才 countActiveByListing(listingId)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="410" y="930" width="580" height="62" as="geometry"/></mxCell><mxCell id="d5" value="已有有效订单？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575.0" y="1014.0" width="250" height="92" as="geometry"/></mxCell><mxCell id="e5" value="ALREADY_RESERVED&lt;br&gt;回滚，同书至多一条有效订单" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1080" y="1030" width="340" height="62" as="geometry"/></mxCell><mxCell id="end-e5-outer" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#111827;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1434" y="1049" width="24" height="24" as="geometry"/></mxCell><mxCell id="end-e5-inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="1440" y="1055" width="12" height="12" as="geometry"/></mxCell><mxCell id="e5-end5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#dc2626;" edge="1" parent="1" source="e5" target="end-e5-outer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="insert(order)；updateAvailability(已预留)&lt;br&gt;commit；返回 RESERVED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="410" y="1150" width="580" height="70" as="geometry"/></mxCell><mxCell id="merge" value="合并" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650.0" y="1221.0" width="100" height="34" as="geometry"/></mxCell><mxCell id="a6" value="返回 RESULT&lt;br&gt;（RESERVED 或原订单状态）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="520" y="1262" width="360" height="44" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="688" y="1336" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend" value="图例：蓝=Controller/买家边界；绿=Service 事务内动作；黄=守卫判断；红=异常出口（回滚）→ ◉ 异常终止。&lt;br&gt;说明：异常分支均由服务返回错误码；失败不写半完成数据，不新增 OrderStatus。&lt;br&gt;C · 2026-11-24 · 设计推演，未实现、未实测" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#4b5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="1370" width="1200" height="48" as="geometry"/></mxCell><mxCell id="s-a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;" edge="1" parent="1" source="start" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a1-d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;" edge="1" parent="1" source="a1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1-e1" value="[不成立]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#dc2626;fontSize=9;fontColor=#b91c1c;" edge="1" parent="1" source="d1" target="e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1-a2" value="[成立]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=9;fontColor=#166534;" edge="1" parent="1" source="d1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2-d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;" edge="1" parent="1" source="a2" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2-replay" value="[命中且同书]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#16a34a;fontSize=9;fontColor=#166534;" edge="1" parent="1" source="d2" target="replay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="replay-m