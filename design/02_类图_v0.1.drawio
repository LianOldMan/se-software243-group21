<mxCell id="UserAccount" value="&lt;div style=&quot;font-family:Arial,Microsoft YaHei,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;&quot;&gt;UserAccount &lt;span style=&quot;font-size:11px;color:#607080&quot;&gt;«entity»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- userId: Long&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- accountCode: String&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;（无独立业务变更操作）&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#ffffff;strokeColor=#176b87;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="455" height="330" as="geometry"/></mxCell>
<mxCell id="BookListing" value="&lt;div style=&quot;font-family:Arial,Microsoft YaHei,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;&quot;&gt;BookListing &lt;span style=&quot;font-size:11px;color:#607080&quot;&gt;«entity»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- listingId: Long&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- sellerId: Long&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- title: String&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- author: String&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- price: Decimal&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- conditionGrade: String&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- description: String?&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- availabilityStatus: ListingStatus&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- publishedAt: DateTime&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ isAvailable(): Boolean&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ markReserved(): void&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ markAvailable(): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#ffffff;strokeColor=#176b87;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="180" width="575" height="485" as="geometry"/></mxCell>
<mxCell id="ReservationOrder" value="&lt;div style=&quot;font-family:Arial,Microsoft YaHei,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;&quot;&gt;ReservationOrder &lt;span style=&quot;font-size:11px;color:#607080&quot;&gt;«entity»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- orderId: Long&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- listingId: Long&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- buyerId: Long&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- orderStatus: OrderStatus&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- placedAt: DateTime&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- cancelledAt: DateTime?&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- requestToken: UUIDString&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- /activeListingId: Long?&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ isActive(): Boolean&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ markCancelled(dbNow: DateTime): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#ffffff;strokeColor=#176b87;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="180" width="520" height="485" as="geometry"/></mxCell>
<mxCell id="ReservationController" value="&lt;div style=&quot;font-family:Arial,Microsoft YaHei,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;&quot;&gt;ReservationController &lt;span style=&quot;font-size:11px;color:#607080&quot;&gt;«boundary»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ issueRequestToken(buyerId): UUIDString&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ reserveBook(buyerId,listingId,token): Result&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ cancelReservation(buyerId,orderId): Result&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#ffffff;strokeColor=#7354a2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="530" height="290" as="geometry"/></mxCell>
<mxCell id="ReservationService" value="&lt;div style=&quot;font-family:Arial,Microsoft YaHei,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;&quot;&gt;ReservationService &lt;span style=&quot;font-size:11px;color:#607080&quot;&gt;«control»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- users: UserAccountRepository&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- books: BookListingRepository&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- orders: ReservationOrderRepository&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ issueRequestToken(buyerId): UUIDString&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ placeReservation(buyerId,listingId,token): Result&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ cancelReservation(buyerId,orderId): Result&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#ffffff;strokeColor=#aa6313;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="770" width="810" height="345" as="geometry"/></mxCell>
<mxCell id="UserAccountRepository" value="&lt;div style=&quot;font-family:Arial,Microsoft YaHei,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;&quot;&gt;UserAccountRepository &lt;span style=&quot;font-size:11px;color:#607080&quot;&gt;«repository»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ findById(userId: Long): UserAccount?&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#ffffff;strokeColor=#25756b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="1225" width="555" height="280" as="geometry"/></mxCell>
<mxCell id="BookListingRepository" value="&lt;div style=&quot;font-family:Arial,Microsoft YaHei,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;&quot;&gt;BookListingRepository &lt;span style=&quot;font-size:11px;color:#607080&quot;&gt;«repository»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ lockById(listingId: Long): BookListing?&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ updateAvailability(listingId,state): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#ffffff;strokeColor=#25756b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="745" y="1225" width="615" height="280" as="geometry"/></mxCell>
<mxCell id="ReservationOrderRepository" value="&lt;div style=&quot;font-family:Arial,Microsoft YaHei,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;&quot;&gt;ReservationOrderRepository &lt;span style=&quot;font-size:11px;color:#607080&quot;&gt;«repository»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;hr style=&quot;margin:5px 0&quot;/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ findByBuyerAndToken(buyerId,token)&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ findById(orderId: Long)&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ lockById(orderId: Long)&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ insert(order): ReservationOrder&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ cancelIfActive(orderId,buyerId,dbNow)&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ countActiveByListing(listingId): Int&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#ffffff;strokeColor=#25756b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1460" y="1225" width="570" height="310" as="geometry"/></mxCell>
