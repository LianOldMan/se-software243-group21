<mxfile host="app.diagrams.net" modified="2026-11-23T00:00:00.000Z" agent="C" version="24.0.0">
<diagram id="order-state-v01" name="ReservationOrder 状态图 v0.1">
<mxGraphModel dx="1320" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="780" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="ReservationOrder 订单状态图 v0.1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="700" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="依据：统一类与操作约定 v0.2 ｜ OrderStatus = {有效, 已取消} ｜ 设计推演，未实现、未实测" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4b5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="68" width="1100" height="24" as="geometry"/></mxCell><mxCell id="line" value="" style="line;strokeWidth=1;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="96" width="1180" height="1" as="geometry"/></mxCell><mxCell id="note-top" value="状态集合：OrderStatus = {有效, 已取消}；ListingStatus = {可售, 已预留}。不新增“已支付/已完成/已发货”等状态。&lt;br&gt;已取消是业务终态：记录保留、不物理删除；再次预留必须新建 orderId，旧订单不能复活。&lt;br&gt;失败与拒绝不是状态迁移：返回错误码，订单和书籍的已有状态保持不变。" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10.5;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="50" y="118" width="1180" height="86" as="geometry"/></mxCell><mxCell id="init" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="24" height="24" as="geometry"/></mxCell><mxCell id="active" value="&lt;b&gt;有效（Active）&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;orderStatus = 有效&lt;br&gt;activeListingId = listingId&lt;br&gt;cancelledAt = NULL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="200" y="282" width="280" height="126" as="geometry"/></mxCell><mxCell id="cancelled" value="&lt;b&gt;已取消（Cancelled）&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;orderStatus = 已取消&lt;br&gt;cancelledAt = DB NOW(6)&lt;br&gt;activeListingId = NULL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="650" y="282" width="280" height="126" as="geometry"/></mxCell><mxCell id="final-outer" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#111827;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1028" y="323" width="44" height="44" as="geometry"/></mxCell><mxCell id="final-inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="1039" y="334" width="22" height="22" as="geometry"/></mxCell><mxCell id="e-create" value="createOrder [账号/书/token 合法]&lt;br&gt;/ 建有效订单；placedAt=DB NOW" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="init" target="active"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-cancel" value="cancelReservation [本人 ∧ 有效]&lt;br&gt;/ markCancelled(DB NOW); 释放书" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#b91c1c;" edge="1" parent="1" source="active" target="cancelled"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-final" value="归档 / 记录保留" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cancelled" target="final-outer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note-reject" value="拒绝路径（不产生状态迁移）：&lt;br&gt;• 非订单买家取消、重复取消、越权取消；&lt;br&gt;• 旧订单已取消后又到达的取消请求；&lt;br&gt;• 订单不存在或状态不是“有效”。&lt;br&gt;处理：返回 FORBIDDEN_CANCEL / ORDER_NOT_ACTIVE / ORDER_NOT_FOUND；O 与 X 的状态、历史和其他订单均不变。" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="600" height="120" as="geometry"/></mxCell><mxCell id="note-fail" value="创建失败（不产生订单记录）：&lt;br&gt;• 账号无效、书不存在或不可售；&lt;br&gt;• 买家就是发布者（R-04）；&lt;br&gt;• token 跨书复用、并发冲突、系统故障。&lt;br&gt;保证：失败不写半完成数据；不新增 OrderStatus；由服务事务回滚，书籍状态不被错误占用。" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="500" width="560" height="120" as="geometry"/></mxCell><mxCell id="legend" value="图例：● 初始伪状态   ▭ 业务状态   ◉ 终止（生命周期结束，记录保留）   → 事件 [守卫] / 动作&lt;br&gt;说明：状态图只表达合法状态迁移；拒绝/失败路径以注释表示，不能画成新的订单状态。" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#4b5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="660" width="1180" height="60" as="geometry"/></mxCell><mxCell id="meta" value="C · 2026-11-23 · 设计推演，未实现、未实测" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#9ca3af;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="738" width="600" height="20" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>